# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.ruff_cache/

# Third-party clones (MOSS-Audio is cloned separately; see README)
third_party/

# Training outputs (LoRA checkpoints, large, regenerable)
outputs/

# Rendered datasets: audio is regenerable from the manifest via
# `sceneledger-render` (deterministic) or by extracting audio.tar.
# Keep manifests / data cards / listen lists (small text).
data/derived/*/audio/
data/derived/*/stems/
data/derived/*/audio.tar

# Generated predictions (regenerable from the manifest + model)
reports/*.jsonl

# Large per-sample metrics (regenerable via sceneledger-evaluate).
# Keep small summary reports checked in for reproducibility.
reports/b0_metrics.json
reports/b0_metrics_moss.json
reports/b0_infer_report.json
reports/b0_robustness.json
reports/b1_metrics.json
reports/b1_robustness.json
reports/b2_time_weight_10_metrics.json
