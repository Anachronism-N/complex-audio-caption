{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Anachronism-N/complex-audio-caption/schemas/track_event_ledger.schema.json",
  "title": "SceneLedger track-event representation",
  "description": "Version 0.2 representation with persistent source tracks and caption events. Cross-reference and temporal-order constraints are additionally checked by the Python validator.",
  "type": "object",
  "required": [
    "schema_version",
    "sample_id",
    "duration_sec",
    "time_resolution_sec",
    "tracks",
    "events"
  ],
  "properties": {
    "schema_version": {
      "const": "0.2.0"
    },
    "sample_id": {
      "type": "string",
      "minLength": 1
    },
    "duration_sec": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "time_resolution_sec": {
      "const": 0.1
    },
    "language": {
      "type": ["string", "null"]
    },
    "conditions": {
      "$ref": "#/$defs/conditions"
    },
    "tracks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/track"
      }
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/event"
      }
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "span": {
      "type": "object",
      "required": ["start_sec", "end_sec"],
      "properties": {
        "start_sec": {
          "type": "number",
          "minimum": 0,
          "description": "Must lie on the 0.1-second grid; checked with numeric tolerance by the Python validator."
        },
        "end_sec": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Must lie on the 0.1-second grid; checked with numeric tolerance by the Python validator."
        },
        "start_uncertainty_sec": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "end_uncertainty_sec": {
          "type": ["number", "null"],
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "properties": {
        "method": {
          "type": "string"
        },
        "audio_support": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1
        },
        "target_residual_margin": {
          "type": ["number", "null"]
        },
        "av_support": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1
        },
        "waveform_uri": {
          "type": ["string", "null"]
        },
        "mask_uri": {
          "type": ["string", "null"]
        }
      },
      "additionalProperties": false
    },
    "track": {
      "type": "object",
      "required": ["id", "kind", "spans", "confidence"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^T[0-9]+$"
        },
        "kind": {
          "enum": ["speech", "vocal", "music", "sfx", "ambience", "residual"]
        },
        "identity": {
          "type": ["string", "null"],
          "description": "Anonymous within-clip identity such as speaker_1 or singer_1."
        },
        "spans": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/span"
          }
        },
        "audibility": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        },
        "attributes": {
          "type": "object",
          "additionalProperties": {
            "type": ["string", "number", "boolean", "null"]
          }
        }
      },
      "additionalProperties": false
    },
    "event": {
      "type": "object",
      "required": ["id", "type", "track_id", "spans", "text", "confidence"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^E[0-9]+$"
        },
        "type": {
          "enum": ["speech", "lys", "music", "sfx"]
        },
        "track_id": {
          "type": ["string", "null"],
          "description": "Must reference an existing track ID; null is reserved for unresolved residual evidence."
        },
        "spans": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/span"
          }
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "verbatim": {
          "type": ["boolean", "null"],
          "description": "True for speech/lyrics intended as a verbatim transcription."
        },
        "language": {
          "type": ["string", "null"]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        },
        "relations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["predicate", "target_event_id"],
            "properties": {
              "predicate": {
                "enum": ["before", "after", "overlaps", "interrupts", "causes", "echo_of"]
              },
              "target_event_id": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "attributes": {
          "type": "object",
          "additionalProperties": {
            "type": ["string", "number", "boolean", "null"]
          }
        }
      },
      "additionalProperties": false
    },
    "conditions": {
      "type": "object",
      "properties": {
        "domain": {
          "type": ["string", "null"]
        },
        "snr_db": {
          "type": ["number", "null"]
        },
        "t60_sec": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "echo": {
          "type": ["boolean", "null"]
        },
        "codec": {
          "type": ["string", "null"]
        },
        "overlap_ratio": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "properties": {
        "label_level": {
          "enum": ["A", "B", "C", "D", "E", "human", "model_prediction"]
        },
        "source_dataset": {
          "type": ["string", "null"]
        },
        "renderer_manifest_uri": {
          "type": ["string", "null"]
        },
        "teacher_versions": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "license_status": {
          "type": ["string", "null"]
        }
      },
      "additionalProperties": false
    }
  }
}
